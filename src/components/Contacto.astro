---
// Sección Contacto, Ubicación y Formulario - Sprint 0 (Estructura vacía)
---

<section id="contacto" class="py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="rounded-xl border border-dashed border-neutral-300 bg-white p-8">
      <span class="inline-block rounded bg-neutral-200 px-2.5 py-1 text-xs font-medium text-neutral-700">
        [SECCIÓN: CONTACTO, UBICACIÓN Y FORMULARIO]
      </span>
      <h2 class="mt-3 text-2xl font-bold text-neutral-900 sm:text-3xl">
        Contacto y ubicación
      </h2>

      <div class="mt-8 grid gap-8 lg:grid-cols-2">
        <div class="space-y-3 rounded-lg border border-neutral-200 bg-neutral-50 p-6 text-sm text-neutral-600">
          <p><strong>WhatsApp:</strong> [A CONFIRMAR]</p>
          <p><strong>Instagram:</strong> [A CONFIRMAR]</p>
          <p><strong>Dirección / Zona:</strong> San Juan [A CONFIRMAR]</p>
          <p><strong>Horarios:</strong> [A CONFIRMAR]</p>
          <p><strong>Email:</strong> [A CONFIRMAR]</p>
          <div class="mt-4 flex h-40 items-center justify-center rounded border border-neutral-200 bg-white text-neutral-400">
            [MAPA GOOGLE MAPS A CONFIRMAR]
          </div>
        </div>

        <div class="rounded-lg border border-neutral-200 bg-neutral-50 p-6">
          <p class="mb-4 text-sm font-medium text-neutral-700">
            Formulario de consulta [CONECTAR EN SPRINT 2]
          </p>
          <form class="space-y-4" onsubmit="return false;">
            <input
              type="text"
              placeholder="Nombre"
              disabled
              class="w-full rounded-md border border-neutral-300 bg-white px-3 py-2 text-sm text-neutral-400"
            />
            <input
              type="tel"
              placeholder="Teléfono / WhatsApp"
              disabled
              class="w-full rounded-md border border-neutral-300 bg-white px-3 py-2 text-sm text-neutral-400"
            />
            <textarea
              rows="3"
              placeholder="Contanos qué mueble necesitás..."
              disabled
              class="w-full rounded-md border border-neutral-300 bg-white px-3 py-2 text-sm text-neutral-400"
            ></textarea>
            <button
              type="button"
              disabled
              class="w-full rounded-md bg-neutral-400 px-4 py-2 text-sm font-medium text-white"
            >
              Enviar consulta (Inactivo en S0)
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>